# Variables d'environnement pour l'application MyApp

# CONFIGURATION API
# ==================
# MODE PRODUCTION: Connexion au backend réel activée
EXPO_PUBLIC_USE_MOCK_DATA=false

# URL de base de l'API backend - remplacez l'IP par celle de votre machine
EXPO_PUBLIC_API_URL=http://192.168.1.75:3000

# URLs spécifiques (optionnelles - générées automatiquement si non définies)
EXPO_PUBLIC_AUTH_URL=http://192.168.1.75:3000/api/v1/auth
EXPO_PUBLIC_CHAT_URL=http://192.168.1.75:3000/api/chat
EXPO_PUBLIC_GRAPHQL_URL=http://192.168.1.75:3000/graphql
EXPO_PUBLIC_PROPERTY_URL=http://192.168.1.75:3000/api/properties
EXPO_PUBLIC_WALLET_URL=http://192.168.1.75:3000/api/wallet
EXPO_PUBLIC_SERVICES_URL=http://192.168.1.75:3000/api/services

# WEBSOCKETS & TEMPS RÉEL
# =======================
# URL WebSocket pour GraphQL subscriptions
EXPO_PUBLIC_WS_URL=ws://192.168.1.75:3000

# URL Socket.IO pour le chat temps réel
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.75:3000


